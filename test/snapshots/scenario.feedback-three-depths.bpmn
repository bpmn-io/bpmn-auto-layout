<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_feedback_three_depths" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_feedback_three_depths">
    <bpmn:documentation>Keep three nested feedback depths ordered around the main spine without routing local feedback around an unrelated upper escalation branch.</bpmn:documentation>
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_start_outer_merge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="OuterMerge">
      <bpmn:incoming>Flow_start_outer_merge</bpmn:incoming>
      <bpmn:incoming>Flow_outer_feedback</bpmn:incoming>
      <bpmn:outgoing>Flow_outer_prepare</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="PrepareOuter">
      <bpmn:incoming>Flow_outer_prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_middle_merge</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="MiddleMerge">
      <bpmn:incoming>Flow_middle_merge</bpmn:incoming>
      <bpmn:incoming>Flow_middle_feedback</bpmn:incoming>
      <bpmn:outgoing>Flow_middle_prepare</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="PrepareMiddle">
      <bpmn:incoming>Flow_middle_prepare</bpmn:incoming>
      <bpmn:outgoing>Flow_split</bpmn:outgoing>
    </bpmn:task>
    <bpmn:boundaryEvent id="EscalationBoundary" cancelActivity="false" attachedToRef="PrepareMiddle">
      <bpmn:outgoing>Flow_escalation_task</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EscalationDefinition" />
    </bpmn:boundaryEvent>
    <bpmn:task id="EscalationTask">
      <bpmn:incoming>Flow_escalation_task</bpmn:incoming>
      <bpmn:outgoing>Flow_escalation_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EscalationEnd">
      <bpmn:incoming>Flow_escalation_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Split">
      <bpmn:incoming>Flow_split</bpmn:incoming>
      <bpmn:incoming>Flow_direct_feedback</bpmn:incoming>
      <bpmn:incoming>Flow_nested_feedback</bpmn:incoming>
      <bpmn:outgoing>Flow_finish</bpmn:outgoing>
      <bpmn:outgoing>Flow_direct_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_nested_choice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Finish">
      <bpmn:incoming>Flow_finish</bpmn:incoming>
      <bpmn:outgoing>Flow_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End">
      <bpmn:incoming>Flow_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="DirectRetry">
      <bpmn:incoming>Flow_direct_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_direct_wait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="DirectWait">
      <bpmn:incoming>Flow_direct_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_direct_feedback</bpmn:outgoing>
      <bpmn:messageEventDefinition id="DirectMessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="NestedChoice">
      <bpmn:incoming>Flow_nested_choice</bpmn:incoming>
      <bpmn:outgoing>Flow_nested_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_deep_choice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="NestedRetry">
      <bpmn:incoming>Flow_nested_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_nested_wait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="NestedWait">
      <bpmn:incoming>Flow_nested_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_nested_feedback</bpmn:outgoing>
      <bpmn:messageEventDefinition id="NestedMessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="DeepChoice">
      <bpmn:incoming>Flow_deep_choice</bpmn:incoming>
      <bpmn:outgoing>Flow_middle_retry</bpmn:outgoing>
      <bpmn:outgoing>Flow_outer_retry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="MiddleRetry">
      <bpmn:incoming>Flow_middle_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_middle_wait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="MiddleWait">
      <bpmn:incoming>Flow_middle_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_middle_feedback</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MiddleMessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="OuterRetry">
      <bpmn:incoming>Flow_outer_retry</bpmn:incoming>
      <bpmn:outgoing>Flow_outer_wait</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="OuterWait">
      <bpmn:incoming>Flow_outer_wait</bpmn:incoming>
      <bpmn:outgoing>Flow_outer_feedback</bpmn:outgoing>
      <bpmn:messageEventDefinition id="OuterMessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_start_outer_merge" sourceRef="Start" targetRef="OuterMerge" />
    <bpmn:sequenceFlow id="Flow_outer_prepare" sourceRef="OuterMerge" targetRef="PrepareOuter" />
    <bpmn:sequenceFlow id="Flow_middle_merge" sourceRef="PrepareOuter" targetRef="MiddleMerge" />
    <bpmn:sequenceFlow id="Flow_middle_prepare" sourceRef="MiddleMerge" targetRef="PrepareMiddle" />
    <bpmn:sequenceFlow id="Flow_split" sourceRef="PrepareMiddle" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_finish" sourceRef="Split" targetRef="Finish" />
    <bpmn:sequenceFlow id="Flow_end" sourceRef="Finish" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_direct_retry" sourceRef="Split" targetRef="DirectRetry" />
    <bpmn:sequenceFlow id="Flow_direct_wait" sourceRef="DirectRetry" targetRef="DirectWait" />
    <bpmn:sequenceFlow id="Flow_direct_feedback" sourceRef="DirectWait" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_nested_choice" sourceRef="Split" targetRef="NestedChoice" />
    <bpmn:sequenceFlow id="Flow_nested_retry" sourceRef="NestedChoice" targetRef="NestedRetry" />
    <bpmn:sequenceFlow id="Flow_nested_wait" sourceRef="NestedRetry" targetRef="NestedWait" />
    <bpmn:sequenceFlow id="Flow_nested_feedback" sourceRef="NestedWait" targetRef="Split" />
    <bpmn:sequenceFlow id="Flow_deep_choice" sourceRef="NestedChoice" targetRef="DeepChoice" />
    <bpmn:sequenceFlow id="Flow_middle_retry" sourceRef="DeepChoice" targetRef="MiddleRetry" />
    <bpmn:sequenceFlow id="Flow_middle_wait" sourceRef="MiddleRetry" targetRef="MiddleWait" />
    <bpmn:sequenceFlow id="Flow_middle_feedback" sourceRef="MiddleWait" targetRef="MiddleMerge" />
    <bpmn:sequenceFlow id="Flow_outer_retry" sourceRef="DeepChoice" targetRef="OuterRetry" />
    <bpmn:sequenceFlow id="Flow_outer_wait" sourceRef="OuterRetry" targetRef="OuterWait" />
    <bpmn:sequenceFlow id="Flow_outer_feedback" sourceRef="OuterWait" targetRef="OuterMerge" />
    <bpmn:sequenceFlow id="Flow_escalation_task" sourceRef="EscalationBoundary" targetRef="EscalationTask" />
    <bpmn:sequenceFlow id="Flow_escalation_end" sourceRef="EscalationTask" targetRef="EscalationEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_feedback_three_depths">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_feedback_three_depths" bpmnElement="Process_feedback_three_depths">
