{
  "name": "bpmn-auto-layout",
  "version": "2.0.0-alpha.2",
  "description": "Layout BPMN diagrams, generating missing DI information",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "bpmn-auto-layout": "./dist/bpmn-auto-layout.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "all": "run-s lint typecheck test",
    "lint": "eslint .",
    "typecheck": "run-s typecheck:source typecheck:public-api",
    "typecheck:source": "tsc",
    "typecheck:public-api": "tsc --project tsconfig.public-api.json",
    "test": "tsx node_modules/mocha/bin/mocha.js --extension js --extension ts --timeout 15000",
    "test:inspect": "node tasks/inspect.mjs",
    "test:update-snapshots": "cross-env UPDATE_SNAPSHOTS=true mocha --timeout 15000",
    "render:fixture": "npm run build && tsx tasks/render-fixture.ts",
    "review:layout": "node tasks/layout-review.mjs",
    "benchmark:fixture": "npm run build && tsx tasks/benchmark-fixture.ts",
    "test:performance": "npm run build && tsx tasks/performance-guardrails.ts",
    "trace:fixture": "npm run build:example && node tasks/trace-fixture.mjs",
    "metrics": "node test/metrics.mjs",
    "metrics:update": "cross-env UPDATE_BASELINE=true node test/metrics.mjs",
    "pretest": "run-s build",
    "build": "run-s build:bundle build:types",
    "build:bundle": "rollup -c",
    "build:types": "tsc --project tsconfig.declarations.json",
    "generate:moddle-types": "moddle-generate-types --augment --index lib/moddle-types/index.d.ts node_modules/bpmn-moddle/resources/bpmn/json/bpmn.json lib/moddle-types/bpmn.d.ts node_modules/bpmn-moddle/resources/bpmn/json/bpmndi.json lib/moddle-types/bpmndi.d.ts node_modules/bpmn-moddle/resources/bpmn/json/dc.json lib/moddle-types/dc.d.ts node_modules/bpmn-moddle/resources/bpmn/json/di.json lib/moddle-types/di.d.ts",
    "check:moddle-types": "npm run generate:moddle-types && git diff --exit-code -- lib/moddle-types",
    "build:example": "npm run build -w example",
    "prepare": "run-s build",
    "start": "npm run start -w example"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bpmn-io/bpmn-auto-layout.git"
  },
  "keywords": [
    "bpmn",
    "layout"
  ],
  "author": {
    "name": "bpmn.io contributors",
    "url": "https://github.com/bpmn-io"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bpmn-io/bpmn-auto-layout/issues"
  },
  "homepage": "https://github.com/bpmn-io/bpmn-auto-layout#readme",
  "dependencies": {
    "bpmn-moddle": "^10.0.0",
    "min-dash": "^5.0.0"
  },
  "devDependencies": {
    "@bpmn-io/moddle-types-generator": "^0.2.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/moddle": "^5.0.3",
    "@types/node": "^24.13.3",
    "bpmn-to-image": "^0.10.0",
    "cross-env": "^10.1.0",
    "diagram-js": "^15.23.0",
    "eslint": "^9.39.2",
    "eslint-plugin-bpmn-io": "^2.2.0",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "open-cli": "^8.0.0",
    "puppeteer": "^25.3.0",
    "rollup": "^4.57.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">= 22"
  },
  "workspaces": [
    "example"
  ]
}
